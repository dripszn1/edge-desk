# Copy to /etc/edge-desk/env on the SERVER (chmod 600) and fill in there. Never commit the filled copy.
# Same names as the GitHub Actions secrets.
EDGE_RUNNER=vps
ODDS_API_KEY=
CFBD_API_KEY=
NTFY_TOPIC=
PUSHOVER_TOKEN=
PUSHOVER_USER=
KALSHI_KEY_ID=
# leave KALSHI_PRIVATE_KEY empty; the key file is mounted by edge-desk.service:
KALSHI_PRIVATE_KEY_FILE=/run/secrets/kalshi.pem
